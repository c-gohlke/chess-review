{
	"openapi": "3.1.0",
	"info": {
		"title": "FastAPI",
		"version": "0.1.0"
	},
	"paths": {
		"/api/import/chesscom/{username}": {
			"post": {
				"summary": "Import Chesscom",
				"operationId": "import_chesscom_api_import_chesscom__username__post",
				"parameters": [
					{
						"name": "username",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"title": "Username"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ImportResult"
								}
							}
						}
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
		"/api/games": {
			"get": {
				"summary": "Get Games",
				"operationId": "get_games_api_games_get",
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/GameSummary"
									},
									"type": "array",
									"title": "Response Get Games Api Games Get"
								}
							}
						}
					}
				}
			}
		},
		"/api/games/{game_id}": {
			"get": {
				"summary": "Get Game Detail",
				"operationId": "get_game_detail_api_games__game_id__get",
				"parameters": [
					{
						"name": "game_id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "integer",
							"title": "Game Id"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/GameDetail"
								}
							}
						}
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
		"/api/health": {
			"get": {
				"summary": "Health",
				"operationId": "health_api_health_get",
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"additionalProperties": {
										"type": "string"
									},
									"type": "object",
									"title": "Response Health Api Health Get"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"GameDetail": {
				"properties": {
					"id": {
						"type": "integer",
						"title": "Id"
					},
					"white": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "White"
					},
					"black": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Black"
					},
					"result": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Result"
					},
					"time_class": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Time Class"
					},
					"played_at": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Played At"
					},
					"pgn": {
						"type": "string",
						"title": "Pgn"
					}
				},
				"type": "object",
				"required": ["id", "white", "black", "result", "time_class", "played_at", "pgn"],
				"title": "GameDetail"
			},
			"GameSummary": {
				"properties": {
					"id": {
						"type": "integer",
						"title": "Id"
					},
					"white": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "White"
					},
					"black": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Black"
					},
					"result": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Result"
					},
					"time_class": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Time Class"
					},
					"played_at": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Played At"
					}
				},
				"type": "object",
				"required": ["id", "white", "black", "result", "time_class", "played_at"],
				"title": "GameSummary"
			},
			"HTTPValidationError": {
				"properties": {
					"detail": {
						"items": {
							"$ref": "#/components/schemas/ValidationError"
						},
						"type": "array",
						"title": "Detail"
					}
				},
				"type": "object",
				"title": "HTTPValidationError"
			},
			"ImportResult": {
				"properties": {
					"imported": {
						"type": "integer",
						"title": "Imported"
					}
				},
				"type": "object",
				"required": ["imported"],
				"title": "ImportResult"
			},
			"ValidationError": {
				"properties": {
					"loc": {
						"items": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "integer"
								}
							]
						},
						"type": "array",
						"title": "Location"
					},
					"msg": {
						"type": "string",
						"title": "Message"
					},
					"type": {
						"type": "string",
						"title": "Error Type"
					},
					"input": {
						"title": "Input"
					},
					"ctx": {
						"type": "object",
						"title": "Context"
					}
				},
				"type": "object",
				"required": ["loc", "msg", "type"],
				"title": "ValidationError"
			}
		}
	}
}
