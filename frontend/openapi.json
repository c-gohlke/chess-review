{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/import/chesscom/{username}": {
      "post": {
        "summary": "Import Chesscom",
        "operationId": "import_chesscom_api_import_chesscom__username__post",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Username"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/games": {
      "get": {
        "summary": "Get Games",
        "operationId": "get_games_api_games_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameListItem"
                  },
                  "title": "Response Get Games Api Games Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{game_id}": {
      "get": {
        "summary": "Get Game Detail",
        "operationId": "get_game_detail_api_games__game_id__get",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Game Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/openings": {
      "get": {
        "summary": "Get Openings",
        "operationId": "get_openings_api_openings_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "time_class",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TimeClass"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Time Class"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpeningSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/evaluation": {
      "get": {
        "summary": "Get Position Evaluation",
        "operationId": "get_position_evaluation_api_evaluation_get",
        "parameters": [
          {
            "name": "fen",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Fen"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Evaluation": {
        "properties": {
          "cp": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cp"
          },
          "mate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mate"
          }
        },
        "type": "object",
        "required": [
          "cp",
          "mate"
        ],
        "title": "Evaluation",
        "description": "From White's point of view. Exactly one of the two is set; mate 0 means the position is checkmate."
      },
      "GameDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "white": {
            "type": "string",
            "title": "White"
          },
          "black": {
            "type": "string",
            "title": "Black"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          },
          "time_class": {
            "$ref": "#/components/schemas/TimeClass"
          },
          "played_at": {
            "type": "string",
            "format": "date-time",
            "title": "Played At"
          },
          "pgn": {
            "type": "string",
            "title": "Pgn"
          }
        },
        "type": "object",
        "required": [
          "id",
          "white",
          "black",
          "result",
          "time_class",
          "played_at",
          "pgn"
        ],
        "title": "GameDetail"
      },
      "GameListItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "white": {
            "type": "string",
            "title": "White"
          },
          "black": {
            "type": "string",
            "title": "Black"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          },
          "time_class": {
            "$ref": "#/components/schemas/TimeClass"
          },
          "played_at": {
            "type": "string",
            "format": "date-time",
            "title": "Played At"
          },
          "opening": {
            "type": "string",
            "title": "Opening"
          },
          "rating_change": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating Change"
          }
        },
        "type": "object",
        "required": [
          "id",
          "white",
          "black",
          "result",
          "time_class",
          "played_at",
          "opening",
          "rating_change"
        ],
        "title": "GameListItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportResult": {
        "properties": {
          "imported": {
            "type": "integer",
            "title": "Imported"
          }
        },
        "type": "object",
        "required": [
          "imported"
        ],
        "title": "ImportResult"
      },
      "OpeningStats": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "games": {
            "type": "integer",
            "title": "Games"
          },
          "wins": {
            "type": "integer",
            "title": "Wins"
          },
          "draws": {
            "type": "integer",
            "title": "Draws"
          },
          "losses": {
            "type": "integer",
            "title": "Losses"
          },
          "net": {
            "type": "number",
            "title": "Net"
          },
          "variations": {
            "items": {
              "$ref": "#/components/schemas/OpeningStats"
            },
            "type": "array",
            "title": "Variations"
          }
        },
        "type": "object",
        "required": [
          "name",
          "games",
          "wins",
          "draws",
          "losses",
          "net",
          "variations"
        ],
        "title": "OpeningStats"
      },
      "OpeningSummary": {
        "properties": {
          "white": {
            "items": {
              "$ref": "#/components/schemas/OpeningStats"
            },
            "type": "array",
            "title": "White"
          },
          "black": {
            "items": {
              "$ref": "#/components/schemas/OpeningStats"
            },
            "type": "array",
            "title": "Black"
          }
        },
        "type": "object",
        "required": [
          "white",
          "black"
        ],
        "title": "OpeningSummary"
      },
      "Result": {
        "type": "string",
        "enum": [
          "win",
          "loss",
          "draw"
        ],
        "title": "Result"
      },
      "TimeClass": {
        "type": "string",
        "enum": [
          "daily",
          "rapid",
          "blitz",
          "bullet"
        ],
        "title": "TimeClass"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
