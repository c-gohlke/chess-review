  "components": {
    "schemas": {
      "AnalysisState": {
        "properties": {
          "games": {
            "type": "integer",
            "title": "Games"
          },
          "unanalysed": {
            "type": "integer",
            "title": "Unanalysed"
          },
          "phase": {
            "type": "string",
            "enum": [
              "idle",
              "preparing",
              "analysing",
              "classifying",
              "failed"
            ],
            "title": "Phase"
          },
          "done": {
            "type": "integer",
            "title": "Done"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "running_player": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Running Player"
          }
        },
        "type": "object",
        "required": [
          "games",
          "unanalysed",
          "phase",
          "done",
          "total",
          "error",
          "running_player"
        ],
        "title": "AnalysisState"
      },
      "Evaluation": {
        "properties": {
          "cp": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cp"
          },
          "mate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mate"
          }
        },
        "type": "object",
        "required": [
          "cp",
          "mate"
        ],
        "title": "Evaluation",
        "description": "From White's point of view. Exactly one of the two is set; mate 0 means the position is checkmate."
      },
      "ForkKind": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "losses": {
            "type": "integer",
            "title": "Losses"
          }
        },
        "type": "object",
        "required": [
          "name",
          "losses"
        ],
        "title": "ForkKind"
      },
      "ForkSummary": {
        "properties": {
          "analysed_losses": {
            "type": "integer",
            "title": "Analysed Losses"
          },
          "losses_with_fork": {
            "type": "integer",
            "title": "Losses With Fork"
          },
          "decided_by_fork": {
            "type": "integer",
            "title": "Decided By Fork"
          },
          "kinds": {
            "items": {
              "$ref": "#/components/schemas/ForkKind"
            },
            "type": "array",
            "title": "Kinds"
          }
        },
        "type": "object",
        "required": [
          "analysed_losses",
          "losses_with_fork",
          "decided_by_fork",
          "kinds"
        ],
        "title": "ForkSummary"
      },
      "GameAnalysis": {
        "properties": {
          "decided_by": {
            "type": "string",
            "title": "Decided By"
          },
          "moments": {
            "items": {
              "$ref": "#/components/schemas/Moment"
            },
            "type": "array",
            "title": "Moments"
          }
        },
        "type": "object",
        "required": [
          "decided_by",
          "moments"
        ],
        "title": "GameAnalysis"
      },
      "GameDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "white": {
            "type": "string",
            "title": "White"
          },
          "black": {
            "type": "string",
            "title": "Black"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          },
          "time_class": {
            "$ref": "#/components/schemas/TimeClass"
          },
          "played_at": {
            "type": "string",
            "format": "date-time",
            "title": "Played At"
          },
          "pgn": {
            "type": "string",
            "title": "Pgn"
          },
          "colour": {
            "type": "string",
            "enum": [
              "white",
              "black"
            ],
            "title": "Colour"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameAnalysis"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "white",
          "black",
          "result",
          "time_class",
          "played_at",
          "pgn",
          "colour",
          "analysis"
        ],
        "title": "GameDetail"
      },
      "GameListItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "white": {
            "type": "string",
            "title": "White"
          },
          "black": {
            "type": "string",
            "title": "Black"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          },
          "time_class": {
            "$ref": "#/components/schemas/TimeClass"
          },
          "played_at": {
            "type": "string",
            "format": "date-time",
            "title": "Played At"
          },
          "opening": {
            "type": "string",
            "title": "Opening"
          },
          "rating_change": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating Change"
          }
        },
        "type": "object",
        "required": [
          "id",
          "white",
          "black",
          "result",
          "time_class",
          "played_at",
          "opening",
          "rating_change"
        ],
        "title": "GameListItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportResult": {
        "properties": {
          "imported": {
            "type": "integer",
            "title": "Imported"
          }
        },
        "type": "object",
        "required": [
          "imported"
        ],
        "title": "ImportResult"
      },
      "Moment": {
        "properties": {
          "ply": {
            "type": "integer",
            "title": "Ply"
          },
          "move_number": {
            "type": "integer",
            "title": "Move Number"
          },
          "player": {
            "type": "string",
            "title": "Player"
          },
          "is_decisive": {
            "type": "boolean",
            "title": "Is Decisive"
          },
          "win_lost": {
            "type": "integer",
            "title": "Win Lost"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Labels"
          }
        },
        "type": "object",
        "required": [
          "ply",
          "move_number",
          "player",
          "is_decisive",
          "win_lost",
          "labels"
        ],
        "title": "Moment"
      },
      "OpeningStats": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "games": {
            "type": "integer",
            "title": "Games"
          },
          "wins": {
            "type": "integer",
            "title": "Wins"
          },
          "draws": {
            "type": "integer",
            "title": "Draws"
          },
          "losses": {
            "type": "integer",
            "title": "Losses"
          },
          "net": {
            "type": "number",
            "title": "Net"
          },
          "variations": {
            "items": {
              "$ref": "#/components/schemas/OpeningStats"
            },
            "type": "array",
            "title": "Variations"
          }
        },
        "type": "object",
        "required": [
          "name",
          "games",
          "wins",
          "draws",
          "losses",
          "net",
          "variations"
        ],
        "title": "OpeningStats"
      },
      "OpeningSummary": {
        "properties": {
          "white": {
            "items": {
              "$ref": "#/components/schemas/OpeningStats"
            },
            "type": "array",
            "title": "White"
          },
          "black": {
            "items": {
              "$ref": "#/components/schemas/OpeningStats"
            },
            "type": "array",
            "title": "Black"
          }
        },
        "type": "object",
        "required": [
          "white",
          "black"
        ],
        "title": "OpeningSummary"
      },
      "Result": {
        "type": "string",
        "enum": [
          "win",
          "loss",
          "draw"
        ],
        "title": "Result"
      },
      "TimeClass": {
        "type": "string",
        "enum": [
          "daily",
          "rapid",
          "blitz",
          "bullet"
        ],
        "title": "TimeClass"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
